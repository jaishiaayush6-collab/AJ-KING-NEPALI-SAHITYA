}
header h1{margin:0;font-size:30px}
nav{
 background:#101c35;
 padding:14px;
 text-align:center;
}
nav a{
 color:white;
 text-decoration:none;
 margin:10px;
}
.container{max-width:1050px;margin:auto;padding:25px}
.search{
 width:100%;
 padding:14px;
 border:1px solid #ccc;
 border-radius:10px;
 margin:15px 0;
 font-size:16px;
}
.categories{
 display:flex;
 gap:10px;
 flex-wrap:wrap;
 margin:15px 0;
}
.categories button{
 border:0;
 padding:11px 18px;
 border-radius:20px;
 background:#dce5ff;
 cursor:pointer;
}
.categories button:hover{background:#3155a4;color:white}
.grid{
 display:grid;
 grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
 gap:20px;
}
.card{
