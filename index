<body>

<header>
<h1>📚 AAYUSH NEPALI SAHITYA</h1>
<p>नेपाली साहित्यको विशाल संसारमा स्वागत छ</p>
</header>

<nav>
<a href="index.html">गृहपृष्ठ</a>
<a href="sahitya.html">साहित्य</a>
</nav>

<div class="container">

<h2>नेपाली साहित्य पढ्नुहोस्</h2>
<p>आफूलाई मन पर्ने साहित्यिक विधा छान्नुहोस्।</p>

<input class="search" id="search"
placeholder="लेख वा साहित्य खोज्नुहोस्..."
oninput="filterBooks()">

<div class="categories">
<button onclick="filterCategory('सबै')">सबै</button>
<button onclick="filterCategory('कथा')">कथा</button>
<button onclick="filterCategory('कविता')">कविता</button>
<button onclick="filterCategory('निबन्ध')">निबन्ध</button>
<button onclick="filterCategory('बालसाहित्य')">बालसाहित्य</button>
</div>

<div class="grid" id="bookGrid">

<div class="card" data-category="कथा">
<h2>मेहनती विद्यार्थी</h2>
<p>मेहनत र लगनशीलताको प्रेरणादायी कथा।</p>
<a href="read.html?article=story">पूरा पढ्नुहोस् →</a>
</div>

<div class="card" data-category="कविता">
<h2>मेरो सुन्दर नेपाल</h2>
<p>नेपालको प्राकृतिक सुन्दरताबारे कविता।</p>
<a href="read.html?article=poem">पूरा पढ्नुहोस् →</a>
</div>

<div class="card" data-category="निबन्ध">
<h2>शिक्षाको महत्त्व</h2>
<p>मानव जीवनमा शिक्षाको भूमिका।</p>
<a href="read.html?article=essay">पूरा पढ्नुहोस् →</a>
</div>

<div class="card" data-category="बालसाहित्य">
<h2>असल बानी</h2>
<p>बालबालिकाका लागि उपयोगी सन्देश।</p>
<a href="read.html?article=children">पूरा पढ्नुहोस् →</a>
</div>

</div>
</div>

<footer>
<p>© 2026 AAYUSH NEPALI SAHITYA</p>
</footer>

<script>
let selectedCategory = "सबै";

function filterBooks(){
 const keyword=document.getElementById("search").value.toLowerCase();

 document.querySelectorAll(".card").forEach(card=>{
  const text=card.innerText.toLowerCase();
  const category=card.dataset.category;

  card.style.display=
   text.includes(keyword) &&
   (selectedCategory==="सबै" || category===selectedCategory)
   ? "block":"none";
 });
}

function filterCategory(category){
 selectedCategory=category;
 filterBooks();
}
</script>

</body>
